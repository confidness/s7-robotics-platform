# PIN required to create a mentor account. Set it in Vercel → Settings → Environment Variables.
# Use your own value; the placeholder below is not the fallback the app ships with.
#
# Note this is NOT a secret. Vite inlines every VITE_* variable into the client bundle at build
# time, so whatever you set here is readable in the browser's devtools. The PIN keeps a curious
# student out, not a determined one. Real gating needs a server that checks it.
VITE_MENTOR_PIN=00000000

# Anthropic key for the AI mentor. SERVER SIDE ONLY — note there is no VITE_ prefix, which is
# what keeps it out of the client bundle. Set it in Vercel → Settings → Environment Variables,
# never here and never in the repo.
#
# Without it the mentor answers from its built-in knowledge base instead, so the app works
# either way. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
