# PIN required to create a mentor account. SERVER SIDE — note there is no VITE_ prefix, which is
# what keeps it out of the client bundle. Set it in Vercel -> Settings -> Environment Variables.
#
# It is checked by api/mentor-pin.ts, so the browser only ever learns yes or no. With no value
# set the endpoint answers 501 and a development PIN stands in instead, which is fine locally
# and means the deployment is simply not gating mentor accounts.
MENTOR_PIN=

# Anthropic key for the AI mentor. SERVER SIDE ONLY — note there is no VITE_ prefix, which is
# what keeps it out of the client bundle. Set it in Vercel → Settings → Environment Variables,
# never here and never in the repo.
#
# Without it the mentor answers from its built-in knowledge base instead, so the app works
# either way. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed when the key above was created at the organisation level rather than inside a
# workspace. Such a key belongs to no workspace, and Anthropic refuses it with a 400 saying so
# until one is named. A key created inside a workspace carries that itself and needs nothing here.
# Find the id in console.anthropic.com -> Settings -> Workspaces; it looks like wrkspc_01ABC...
ANTHROPIC_WORKSPACE_ID=
